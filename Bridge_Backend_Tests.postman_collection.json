{
  "info": {
    "name": "Bridge Backend - Flutter Tests",
    "description": "Complete test suite for Bridge backend endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "postman_test_{{$randomUUID}}",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Health check returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Health message is correct', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.include('Bridge API is running');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{session_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/autocorrector/session/create",
          "host": ["{{base_url}}"],
          "path": ["autocorrector", "session", "create"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Session created successfully', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Session ID matches', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.session_id).to.eql(pm.variables.get('session_id'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Add Letter H",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"letter\": \"H\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/autocorrector/letter/add",
          "host": ["{{base_url}}"],
          "path": ["autocorrector", "letter", "add"]
        }
      }
    },
    {
      "name": "4. Add Letter O",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"letter\": \"O\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/autocorrector/letter/add",
          "host": ["{{base_url}}"],
          "path": ["autocorrector", "letter", "add"]
        }
      }
    },
    {
      "name": "5. Add Letter L",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"letter\": \"L\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/autocorrector/letter/add",
          "host": ["{{base_url}}"],
          "path": ["autocorrector", "letter", "add"]
        }
      }
    },
    {
      "name": "6. Add Letter A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"letter\": \"A\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/autocorrector/letter/add",
          "host": ["{{base_url}}"],
          "path": ["autocorrector", "letter", "add"]
        }
      }
    },
    {
      "name": "7. Session Status",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{session_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/autocorrector/session/status",
          "host": ["{{base_url}}"],
          "path": ["autocorrector", "session", "status"]
        }
      }
    },
    {
      "name": "8. Finish Word",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"force\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/autocorrector/word/finish",
          "host": ["{{base_url}}"],
          "path": ["autocorrector", "word", "finish"]
        }
      }
    },
    {
      "name": "9. WebSocket Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/realtime/ws/status",
          "host": ["{{base_url}}"],
          "path": ["realtime", "ws", "status"]
        }
      }
    },
    {
      "name": "10. HTTP Detection Fallback",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"frameBase64\": \"/9j/4AAQSkZJRgABAQAAAQABAAD//2Q==\",\n  \"clientId\": \"postman_test_client\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/realtime/detect",
          "host": ["{{base_url}}"],
          "path": ["realtime", "detect"]
        }
      }
    },
    {
      "name": "11. [NEW] Word Builder - Detect Sequence",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{session_id}}_builder\",\n  \"letters\": [\"H\", \"O\", \"L\", \"A\"]\n}"
        },
        "url": {
          "raw": "{{base_url}}/word-builder/detect-sequence",
          "host": ["{{base_url}}"],
          "path": ["word-builder", "detect-sequence"]
        }
      }
    },
    {
      "name": "12. [NEW] BERT Correction",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{session_id}}_bert\",\n  \"word\": \"amgo\",\n  \"context\": \"hola\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/bert/correct-bert",
          "host": ["{{base_url}}"],
          "path": ["bert", "correct-bert"]
        }
      }
    },
    {
      "name": "13. [NEW] Hardened Session Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"{{session_id}}_hardened\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/realtime/session/create",
          "host": ["{{base_url}}"],
          "path": ["realtime", "session", "create"]
        }
      }
    }
  ]
}